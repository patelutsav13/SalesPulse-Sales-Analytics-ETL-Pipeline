# ==============================================================================
# SalesPulse - Backend Configuration Template (.env.example)
# Copy this file to backend/.env and fill in your Databricks details.
# NEVER commit backend/.env or real tokens to GitHub!
# ==============================================================================

# Databricks Workspace Hostname (without https://) and full URL
DATABRICKS_SERVER_HOSTNAME=your-workspace-id.cloud.databricks.com
DATABRICKS_HOST=https://your-workspace-id.cloud.databricks.com

# Databricks SQL Warehouse Connection Details
# Found in Databricks -> SQL Warehouses -> Connection Details
DATABRICKS_WAREHOUSE_ID=your_sql_warehouse_id
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/your_sql_warehouse_id

# Authentication:
# - Leave DATABRICKS_TOKEN empty to use browser OAuth for SQL Warehouse queries.
# - Add a Personal Access Token (PAT) to enable automated Volume Upload & Jobs API.
DATABRICKS_TOKEN=

# Databricks Jobs API (numeric Job ID for sales_etl_pipeline)
DATABRICKS_JOB_ID=201788031701853
# Unity Catalog Hierarchy
DATABRICKS_CATALOG=mypyspark
DATABRICKS_SCHEMA=sales_schema
DATABRICKS_VOLUME=sales_volume

# Local FastAPI Server Settings
PORT=8000
ENVIRONMENT=development
